# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Environment variables
.env
.env.local
.env.production

# Logs
logs/*.log

# Datasets — tracked via DVC or downloaded at runtime
datasets/raw/*
datasets/processed/*
datasets/merged/*
datasets/final/*
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/merged/.gitkeep
!datasets/final/.gitkeep

# Outputs and training artifacts
outputs/*
!outputs/.gitkeep
training/*.pt
training/*.bin
training/*.safetensors
training/checkpoints/

# HuggingFace cache
.cache/
